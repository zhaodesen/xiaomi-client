# =========================================================
# MiMo Desktop — Local Development Environment Variables
# Copy this file to .env (or .env.local) and fill in values.
# DO NOT commit your real .env to git.
# =========================================================

# Xiaomi MiMo API
MIMO_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
MIMO_BASE_URL=https://api.xiaomimimo.com/v1

# Default models
MIMO_MODEL_MULTIMODAL=mimo-v2.5
MIMO_MODEL_TTS=mimo-v2.5-tts

# Local sidecar
# Leave SIDECAR_PORT empty to pick a random free port at startup.
SIDECAR_PORT=
SIDECAR_HOST=127.0.0.1
